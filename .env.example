# URL base del backend, sin barra final.
# En desarrollo dejala vacía: Vite hace proxy de /api a VITE_DEV_API_PROXY.
VITE_API_URL=

# Destino del proxy de desarrollo (solo lo usa vite.config.ts, no llega al navegador)
VITE_DEV_API_PROXY=http://localhost:4000
